// Convert UTC windows to the source epoch for reference shadow-account calculations only.
// A change of broker offset requires quarantine/reconciliation; never reinterpret earlier features.
bool HG6Windows(bool weekly,int offset_minutes,HG5Window &w[]){
 if(offset_minutes < -840 || offset_minutes > 840)return false;
 int n=weekly?ArrayRange(HG6_WEEKLY,0):ArrayRange(HG6_DAILY,0);if(ArrayResize(w,n)!=n)return false;
 long delta=(long)offset_minutes*60000;
 for(int i=0;i<n;i++){
  w[i].open_ms=(weekly?HG6_WEEKLY[i][0]:HG6_DAILY[i][0])+delta;
  w[i].block_ms=(weekly?HG6_WEEKLY[i][1]:HG6_DAILY[i][1])+delta;
  w[i].flatten_ms=(weekly?HG6_WEEKLY[i][2]:HG6_DAILY[i][2])+delta;
  w[i].close_ms=(weekly?HG6_WEEKLY[i][3]:HG6_DAILY[i][3])+delta;
 }return true;
}
