int HG5Partition(const float &x[],const float p,const float regret){
 if(ArraySize(x)!=133)return -1;float v[70];int k=0;for(int j=0;j<68;j++)v[k++]=x[part_cols[j]];v[k++]=p;v[k++]=regret;
 int n=0;for(int step=0;step<4095;step++){if(n<0||n>=ArraySize(part_left))return -1;if(part_left[n]<0)return part_auth[n];n=v[part_feature[n]]<=part_threshold[n]?part_left[n]:part_right[n];}return -1;}
#endif
