float HG5FloatFromBits(uint u){HGFloatBits b;b.u=u;return b.f;}
uint HG5FloatBitsOf(float f){HGFloatBits b;b.f=f;return b.u;}
// float products are exact in binary64; TwoSum captures the rounding residual.
float HG5Fma32(float a,float b,float c){
 double p=(double)a*(double)b,s=p+(double)c,z=s-p,e=(p-(s-z))+((double)c-z);float f=(float)s;
 if(e==0.0||!MathIsValidNumber(s)||!MathIsValidNumber((double)f))return f;
 uint bits=HG5FloatBitsOf(f);uint mag=bits&0x7fffffff;
 if(mag==0x7f800000)return f;
 // Only a binary64 midpoint may double-round; choose the adjacent float if residual crosses midpoint.
 bool up=s>(double)f;bool neg=(bits&0x80000000)!=0;
 uint next=(mag==0)?(up?1:0x80000001):((up!=neg)?bits+1:bits-1);
 double midpoint=((double)f+(double)HG5FloatFromBits(next))*0.5;
 if(s==midpoint && ((up&&e>0)||(!up&&e<0)))return HG5FloatFromBits(next);
 return f;
}
