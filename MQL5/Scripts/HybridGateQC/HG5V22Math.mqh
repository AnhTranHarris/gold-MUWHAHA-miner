float HG5NpTanh(float x){uint bits=HG5FloatBitsOf(x),mag=bits&0x7fffffff; if(mag>0x7f800000)return HG5FloatFromBits(0x7fc00000);if(mag>=0x41100000+0x100000)return HG5FloatFromBits(0x3f800000|(bits&0x80000000));
 int k=(int)((mag&0x7fe00000)>>21)-(int)(0x3d400000>>21);if(k<0)k=0;if(k>31)k=31;
 float y=HG5FloatFromBits(mag)-HG5FloatFromBits(HG5TanhTable[k]);float z=HG5FloatFromBits(HG5TanhTable[224+k]);for(int j=6;j>=1;j--)z=HG5Fma32(z,y,HG5FloatFromBits(HG5TanhTable[j*32+k]));return HG5FloatFromBits(HG5FloatBitsOf(z)|(bits&0x80000000));}
float HG5NpExp(float x){if(x!=x)return HG5FloatFromBits(0x7fc00000);if(x>=88.72283935546875f)return HG5FloatFromBits(0x7f800000);if(x<=-103.97208404541015625f)return 0.f;
 float q=x*1.4426950408889634074f;q=(q+12582912.f)-12582912.f;
 float y=HG5Fma32(q,-0.693145752f,x);y=HG5Fma32(q,-1.42860677e-6f,y);
 float n=HG5Fma32(0.0005082762527590693718f,y,0.006757896990527505f);n=HG5Fma32(n,y,0.0511451208163729835f);n=HG5Fma32(n,y,0.2473615434895520811f);n=HG5Fma32(n,y,0.7257664613233124478f);n=HG5Fma32(n,y,1.f);
 float d=HG5Fma32(0.0215950937568582985f,y,-0.2742335390411667453f);d=HG5Fma32(d,y,1.f);float f=n/d;return (float)((double)f*MathPow(2.,(double)q));}
