bool HG5ReleaseTest(){
 for(int i=0;i<ArraySize(HG5NumericFixtures);i+=3){float x=HG5FloatFromBits(HG5NumericFixtures[i]);if(HG5FloatBitsOf(HG5NpTanh(x))!=HG5NumericFixtures[i+1]||HG5FloatBitsOf(HG5NpExp(x))!=HG5NumericFixtures[i+2]){PrintFormat("HG5ReleaseQC numeric mismatch row %d",i/3);return false;}}
 HG5CommitGate commit;if(!commit.Restore(0,0,true)||!commit.Healthy()||!commit.Begin(1,10)||commit.Healthy()||!commit.JournalDurable(true)||!commit.CheckpointDurable(true)||!commit.CommitPublished(true)||!commit.Healthy()||commit.Cursor()!=10)return false;
 HG5CommitGate fault;if(!fault.Restore(0,0,true)||!fault.Begin(1,10)||fault.CheckpointDurable(true)||fault.Healthy())return false;
 HG5IntentRecord r;HG5IntentGate intent;if(!intent.Prepare(1,100)||!intent.MarkUnknown(r))return false;HG5IntentGate recovered;if(!recovered.Restore(r)||recovered.ConsumePermit(r,true)||recovered.MarkUnknown(r))return false;
 if(!intent.ConsumePermit(r,true)||intent.ConsumePermit(r,true)||!intent.Reconcile(40,HG5_INTENT_PARTIAL,true)||intent.MayRelease()||!intent.Reconcile(100,HG5_INTENT_FILLED,true)||!intent.MayRelease())return false;
 HG5OpsLimits lim;lim.max_quote_age_ms=100;lim.max_queue_us=200;lim.max_service_us=300;lim.max_trade_lag_ms=400;lim.max_queue=5;lim.max_active=6;lim.max_mailbox=7;
 HG5OpsSample s;s.now_us=1000;s.quote_age_ms=100;s.queue_us=200;s.service_us=300;s.trade_lag_ms=400;s.queue=5;s.active=6;s.mailbox=7;s.connected=true;s.calendar_ok=true;s.identity_ok=true;s.history_ok=true;s.reconciled=true;s.storage_ok=true;
 HG5OperationalGate ops;if(!ops.Init(lim)||ops.EntriesAllowed()||ops.Arm(s,false)||!ops.Arm(s,true)||!ops.EntriesAllowed())return false;s.now_us++;s.storage_ok=false;if(ops.Check(s)==0||ops.EntriesAllowed())return false;s.storage_ok=true;if(ops.Arm(s,true))return false;
 PrintFormat("HG5ReleaseQC numeric vectors %d",ArraySize(HG5NumericFixtures)/3);return true;
}
void OnStart(){Print(HG5ReleaseTest()?"HG5ReleaseQC PASS":"HG5ReleaseQC FAIL");}
