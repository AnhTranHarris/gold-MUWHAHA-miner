#ifndef HG5_HOLD_EVENTS_MQH
#define HG5_HOLD_EVENTS_MQH
#include "HG5StateCodec.mqh"
#include "HG5RX136.mqh"
// Source-exact candidate: contiguous local quote indices; no trade API.
// Caller validates full chronological quote prefix. Never retire an active entry.
int HG5Mark(const HG5Quote &q[],int j,int s,int px){return s*((s>0?q[j].bid:q[j].ask)-px)-2;}
int HG5MinI(int a,int b){return a<b?a:b;}
int HG5MaxI(int a,int b){return a>b?a:b;}
int HG5AbsI(int a){return a<0?-a:a;}
float HG5MinF(float a,float b){return a<b?a:b;}
float HG5MaxF(float a,float b){return a>b?a:b;}
float HG5AbsF(float a){return a<0?-a:a;}
double HG5MinD(double a,double b){return a<b?a:b;}
double HG5MaxD(double a,double b){return a>b?a:b;}
double HG5AbsD(double a){return a<0?-a:a;}
struct HG5Hold {
int e;int s;int px;float due;float v;int peak;int trough;int pk;int tk;int old;int anchor;int turn;int sign;double travel;double noise;double ema;double under;double above;long last;bool first;bool done;float floor;
void Init(const HG5Quote &q[],int e_,int s_,float h_,float v_){peak=-1000000;trough=1000000;old=0;anchor=0;turn=0;sign=0;travel=0;noise=0;ema=100;under=0;above=0;first=true;done=false;floor=-1e9f;e=e_;s=s_;px=s>0?q[e].ask:q[e].bid;due=HG5MaxF(0.f,h_-.008f);v=v_;pk=e;tk=e;last=q[e].ms-2000;}
bool Step(const HG5Quote &q[],int j,float &f[]){if(done)return false;bool emit=false;long age_ms=q[j].ms-q[e].ms;float age=age_ms*.001f;int mark=s*((s>0?q[j].bid:q[j].ask)-px)-2;int spread=q[j].ask-q[j].bid; if(j>e){int ch=mark-old,sg=(ch>0)-(ch<0);double dt=q[j].ms-q[j-1].ms;travel+=HG5AbsI(ch);noise=.82*noise+.18*HG5AbsI(ch);if(dt>0)ema=.85*ema+.15*HG5MinD(2000.,dt);under+=dt*(old<0);above+=dt*(old>0);if(sg&&sign&&sg!=sign)turn++;if(sg)sign=sg;}old=mark;if(mark>peak){peak=mark;pk=j;}if(mark<trough){trough=mark;tk=j;}
 bool close=HG5AbsF(age-due)<=.25f;bool guard=age>=29.995f;bool crossing=age>=due&&first;bool move=q[j].ms-last>=2000&&HG5AbsI(mark-anchor)>=30;bool periodic=q[j].ms-last>=3000; if(close||guard||crossing||move||periodic||j==e){emit=true;{ f[0]=age;f[1]=mark;f[2]=peak;f[3]=trough;f[4]=peak-mark;f[5]=mark-trough;f[6]=(q[j].ms-q[pk].ms)*.001f;f[7]=(q[j].ms-q[tk].ms)*.001f;f[8]=noise;f[9]=ema;f[10]=spread;f[11]=travel;f[12]=mark/(travel+1);f[13]=under/(age_ms+1);f[14]=above/(age_ms+1);f[15]=turn;f[16]=j-e+1;f[17]=s;f[18]=due-age;f[19]=v-mark;f[20]=v;f[21]=due;f[22]=s*((s>0?q[j].bid:q[j].ask)-(s>0?q[HG5MaxI(e,j-3)].bid:q[HG5MaxI(e,j-3)].ask));f[23]=s*((s>0?q[j].bid:q[j].ask)-(s>0?q[HG5MaxI(e,j-8)].bid:q[HG5MaxI(e,j-8)].ask));}last=q[j].ms;anchor=mark;}if(crossing)first=false;done=guard;return emit;}

 void ZeroFields(){{e=0;}{s=0;}{px=0;}{due=0;}{v=0;}{peak=0;}{trough=0;}{pk=0;}{tk=0;}{old=0;}{anchor=0;}{turn=0;}{sign=0;}{travel=0;}{noise=0;}{ema=0;}{under=0;}{above=0;}{last=0;}{first=0;}{done=0;}{floor=0;}}
 bool StateFields(HG5StateCodec &codec){{if(!codec.I32(e))return false;}{if(!codec.I32(s))return false;}{if(!codec.I32(px))return false;}{if(!codec.F32(due))return false;}{if(!codec.F32(v))return false;}{if(!codec.I32(peak))return false;}{if(!codec.I32(trough))return false;}{if(!codec.I32(pk))return false;}{if(!codec.I32(tk))return false;}{if(!codec.I32(old))return false;}{if(!codec.I32(anchor))return false;}{if(!codec.I32(turn))return false;}{if(!codec.I32(sign))return false;}{if(!codec.F64(travel))return false;}{if(!codec.F64(noise))return false;}{if(!codec.F64(ema))return false;}{if(!codec.F64(under))return false;}{if(!codec.F64(above))return false;}{if(!codec.I64(last))return false;}{if(!codec.Flag(first))return false;}{if(!codec.Flag(done))return false;}{if(!codec.F32(floor))return false;}return true;}
};
struct HG5Renew {
int e;int s;int px;long t0;float due;float v;int peak;int low;int pk;int lk;int prev;int prevsign;int turns;int anchor;long last;double travel;double noise;double vel[3];double intensity[3];double jump;double rv;double bv;double oldabs;double spreadema;double under;double over;double run;int w[4];bool crossed;bool done;float floor;
void Init(const HG5Quote &q[],int e_,int s_,float h_,float v_){peak=-1000000;low=1000000;prev=0;prevsign=0;turns=0;anchor=0;travel=0;noise=0;for(int k=0;k<3;k++)vel[k]=0;for(int k=0;k<3;k++)intensity[k]=0;jump=0;rv=0;bv=0;oldabs=0;under=0;over=0;run=0;crossed=false;done=false;floor=-1e9f;e=e_;s=s_;px=s>0?q[e].ask:q[e].bid;t0=q[e].ms;due=HG5MaxF(0.f,h_-.008f);v=v_;pk=e;lk=e;last=t0-1000;spreadema=q[e].ask-q[e].bid;for(int k=0;k<4;k++)w[k]=e;}
bool Step(const HG5Quote &q[],int j,float &f[],int &kind){if(done)return false;bool emit=false;long age_ms=q[j].ms-t0;float age=age_ms*.001f;int p=HG5Mark(q,j,s,px),sp=q[j].ask-q[j].bid;int oldpk=peak,oldlow=low;int delta=j>e?p-prev:0;int sg=(delta>0)-(delta<0);if(j>e){double dt=HG5MaxD(0.,double(q[j].ms-q[j-1].ms)),ds=dt*.001;travel+=HG5AbsI(delta);noise=.88*noise+.12*HG5AbsI(delta);spreadema=.94*spreadema+.06*sp;rv=.95*rv+.05*delta*delta;bv=.95*bv+.05*HG5AbsI(delta)*oldabs;oldabs=HG5AbsI(delta);jump=.90*jump+.10*HG5MaxD(0.,HG5AbsD((double)delta)-2*noise);under+=dt*(prev<0);over+=dt*(prev>0);for(int a=0;a<3;a++){double decay=MathExp(-ds/(a==0?.25:a==1?1.:5.));vel[a]=decay*vel[a]+delta;intensity[a]=decay*intensity[a]+1.;}if(sg&&prevsign&&sg!=prevsign){turns++;run=0;}run+=delta;if(sg)prevsign=sg;}prev=p;if(p>peak){peak=p;pk=j;}if(p<low){low=p;lk=j;}const int lag[4]={250,1000,3000,5000};for(int a=0;a<4;a++)while(w[a]<j&&q[w[a]+1].ms<=q[j].ms-lag[a])++w[a];
 bool indep=(j==e)||(q[j].ms-last>=750)||(q[j].ms-last>=125&&(HG5AbsI(p-anchor)>=HG5MaxD(8.,1.5*noise)||peak>oldpk||low<oldlow));bool clock=HG5AbsF(age-due)<=.25f||(!crossed&&age>=due);bool guard=age>=29.995f;bool labeled=false;if(indep||clock||guard||labeled){emit=true;{kind=(indep?1:0)|(clock?2:0)|(guard?4:0)|(labeled?8:0);f[0]=age;f[1]=p;f[2]=peak;f[3]=low;f[4]=peak-p;f[5]=p-low;f[6]=(q[j].ms-q[pk].ms)*.001f;f[7]=(q[j].ms-q[lk].ms)*.001f;f[8]=noise;f[9]=sp;f[10]=spreadema;f[11]=travel;f[12]=p/(travel+1);f[13]=under/(age_ms+1);f[14]=over/(age_ms+1);f[15]=turns;f[16]=j-e+1;f[17]=s;f[18]=MathSqrt(rv);f[19]=MathSqrt(bv);f[20]=jump;f[21]=run;for(int a=0;a<3;a++){f[22+a]=vel[a];f[25+a]=intensity[a];}for(int a=0;a<4;a++){int u=w[a];f[28+a]=p-HG5Mark(q,u,s,px);f[32+a]=(q[j].ms-q[u].ms)*.001f;}f[36]=double(p-low)/(peak-low+1);f[37]=double(peak-p)/(noise+sp+1);f[38]=s*(q[j].bid-q[HG5MaxI(e,j-1)].bid);f[39]=s*(q[j].ask-q[HG5MaxI(e,j-1)].ask);f[40]=j>e?(q[j].ms-q[j-1].ms)*.001f:0;f[41]=sp-spreadema;f[42]=v-p;f[43]=v;f[44]=due-age;f[45]=due;f[46]=vel[0]/(intensity[0]+1)-vel[2]/(intensity[2]+1);f[47]=HG5MaxD(0.,rv-1.57079632679*bv); }if(indep){last=q[j].ms;anchor=p;}}if(age>=due)crossed=true;
done=guard||age>=due;return emit;}

 void ZeroFields(){{e=0;}{s=0;}{px=0;}{t0=0;}{due=0;}{v=0;}{peak=0;}{low=0;}{pk=0;}{lk=0;}{prev=0;}{prevsign=0;}{turns=0;}{anchor=0;}{last=0;}{travel=0;}{noise=0;}for(int i=0;i<3;i++){vel[i]=0;}for(int i=0;i<3;i++){intensity[i]=0;}{jump=0;}{rv=0;}{bv=0;}{oldabs=0;}{spreadema=0;}{under=0;}{over=0;}{run=0;}for(int i=0;i<4;i++){w[i]=0;}{crossed=0;}{done=0;}{floor=0;}}
 bool StateFields(HG5StateCodec &codec){{if(!codec.I32(e))return false;}{if(!codec.I32(s))return false;}{if(!codec.I32(px))return false;}{if(!codec.I64(t0))return false;}{if(!codec.F32(due))return false;}{if(!codec.F32(v))return false;}{if(!codec.I32(peak))return false;}{if(!codec.I32(low))return false;}{if(!codec.I32(pk))return false;}{if(!codec.I32(lk))return false;}{if(!codec.I32(prev))return false;}{if(!codec.I32(prevsign))return false;}{if(!codec.I32(turns))return false;}{if(!codec.I32(anchor))return false;}{if(!codec.I64(last))return false;}{if(!codec.F64(travel))return false;}{if(!codec.F64(noise))return false;}for(int i=0;i<3;i++){if(!codec.F64(vel[i]))return false;}for(int i=0;i<3;i++){if(!codec.F64(intensity[i]))return false;}{if(!codec.F64(jump))return false;}{if(!codec.F64(rv))return false;}{if(!codec.F64(bv))return false;}{if(!codec.F64(oldabs))return false;}{if(!codec.F64(spreadema))return false;}{if(!codec.F64(under))return false;}{if(!codec.F64(over))return false;}{if(!codec.F64(run))return false;}for(int i=0;i<4;i++){if(!codec.I32(w[i]))return false;}{if(!codec.Flag(crossed))return false;}{if(!codec.Flag(done))return false;}{if(!codec.F32(floor))return false;}return true;}
};
struct HG5Hazard {
int e;int s;int px;long t0;float due;float v;int peak;int low;int pk;int lk;int prev;int prevsign;int turns;int anchor;long last;double pos[3];double neg[3];double up[3];double dn[3];double travel;double noise;double vel[3];double intensity[3];double jump;double rv;double bv;double oldabs;double spreadema;double under;double over;double run;int w[4];bool crossed;bool done;float floor;
void Init(const HG5Quote &q[],int e_,int s_,float h_,float v_){peak=-1000000;low=1000000;prev=0;prevsign=0;turns=0;anchor=0;for(int k=0;k<3;k++)pos[k]=0;for(int k=0;k<3;k++)neg[k]=0;for(int k=0;k<3;k++)up[k]=0;for(int k=0;k<3;k++)dn[k]=0;travel=0;noise=0;for(int k=0;k<3;k++)vel[k]=0;for(int k=0;k<3;k++)intensity[k]=0;jump=0;rv=0;bv=0;oldabs=0;under=0;over=0;run=0;crossed=false;done=false;floor=-1e9f;e=e_;s=s_;px=s>0?q[e].ask:q[e].bid;t0=q[e].ms;due=HG5MaxF(0.f,h_-.008f);v=v_;pk=e;lk=e;last=t0-1000;spreadema=q[e].ask-q[e].bid;for(int k=0;k<4;k++)w[k]=e;}
bool Step(const HG5Quote &q[],int j,float &f[],int &kind){if(done)return false;bool emit=false;long age_ms=q[j].ms-t0;float age=age_ms*.001f;int p=HG5Mark(q,j,s,px),sp=q[j].ask-q[j].bid;int oldpk=peak,oldlow=low;int delta=j>e?p-prev:0;int sg=(delta>0)-(delta<0);if(j>e){double dt=HG5MaxD(0.,double(q[j].ms-q[j-1].ms)),ds=dt*.001;travel+=HG5AbsI(delta);noise=.88*noise+.12*HG5AbsI(delta);spreadema=.94*spreadema+.06*sp;rv=.95*rv+.05*delta*delta;bv=.95*bv+.05*HG5AbsI(delta)*oldabs;oldabs=HG5AbsI(delta);jump=.90*jump+.10*HG5MaxD(0.,HG5AbsD((double)delta)-2*noise);under+=dt*(prev<0);over+=dt*(prev>0);for(int a=0;a<3;a++){double decay=MathExp(-ds/(a==0?.25:a==1?1.:5.));vel[a]=decay*vel[a]+delta;intensity[a]=decay*intensity[a]+1.;pos[a]=decay*pos[a]+(delta>0);neg[a]=decay*neg[a]+(delta<0);up[a]=decay*up[a]+HG5MaxI(0,delta);dn[a]=decay*dn[a]+HG5MaxI(0,-delta);}if(sg&&prevsign&&sg!=prevsign){turns++;run=0;}run+=delta;if(sg)prevsign=sg;}prev=p;if(p>peak){peak=p;pk=j;}if(p<low){low=p;lk=j;}const int lag[4]={250,1000,3000,5000};for(int a=0;a<4;a++)while(w[a]<j&&q[w[a]+1].ms<=q[j].ms-lag[a])++w[a];
 bool indep=(j==e)||(q[j].ms-last>=750)||(q[j].ms-last>=125&&(HG5AbsI(p-anchor)>=HG5MaxD(8.,1.5*noise)||peak>oldpk||low<oldlow));bool clock=HG5AbsF(age-due)<=.25f||(!crossed&&age>=due);bool guard=age>=29.995f;bool labeled=false;if(true){emit=true;{kind=(indep?1:0)|(clock?2:0)|(guard?4:0)|(labeled?8:0);f[0]=age;f[1]=p;f[2]=peak;f[3]=low;f[4]=peak-p;f[5]=p-low;f[6]=(q[j].ms-q[pk].ms)*.001f;f[7]=(q[j].ms-q[lk].ms)*.001f;f[8]=noise;f[9]=sp;f[10]=spreadema;f[11]=travel;f[12]=p/(travel+1);f[13]=under/(age_ms+1);f[14]=over/(age_ms+1);f[15]=turns;f[16]=j-e+1;f[17]=s;f[18]=MathSqrt(rv);f[19]=MathSqrt(bv);f[20]=jump;f[21]=run;for(int a=0;a<3;a++){f[22+a]=vel[a];f[25+a]=intensity[a];}for(int a=0;a<4;a++){int u=w[a];f[28+a]=p-HG5Mark(q,u,s,px);f[32+a]=(q[j].ms-q[u].ms)*.001f;}f[36]=double(p-low)/(peak-low+1);f[37]=double(peak-p)/(noise+sp+1);f[38]=s*(q[j].bid-q[HG5MaxI(e,j-1)].bid);f[39]=s*(q[j].ask-q[HG5MaxI(e,j-1)].ask);f[40]=j>e?(q[j].ms-q[j-1].ms)*.001f:0;f[41]=sp-spreadema;f[42]=v-p;f[43]=v;f[44]=double(v-p)/(noise+1);f[45]=double(v-peak)/(noise+1);f[46]=vel[0]/(intensity[0]+1)-vel[2]/(intensity[2]+1);f[47]=HG5MaxD(0.,rv-1.57079632679*bv);for(int a=0;a<3;a++){f[48+a]=pos[a]/(intensity[a]+1);f[51+a]=neg[a]/(intensity[a]+1);f[54+a]=up[a]/(pos[a]+1);f[57+a]=dn[a]/(neg[a]+1);} }if(indep){last=q[j].ms;anchor=p;}}if(age>=due)crossed=true;
done=age>=30;return emit;
}

 void ZeroFields(){{e=0;}{s=0;}{px=0;}{t0=0;}{due=0;}{v=0;}{peak=0;}{low=0;}{pk=0;}{lk=0;}{prev=0;}{prevsign=0;}{turns=0;}{anchor=0;}{last=0;}for(int i=0;i<3;i++){pos[i]=0;}for(int i=0;i<3;i++){neg[i]=0;}for(int i=0;i<3;i++){up[i]=0;}for(int i=0;i<3;i++){dn[i]=0;}{travel=0;}{noise=0;}for(int i=0;i<3;i++){vel[i]=0;}for(int i=0;i<3;i++){intensity[i]=0;}{jump=0;}{rv=0;}{bv=0;}{oldabs=0;}{spreadema=0;}{under=0;}{over=0;}{run=0;}for(int i=0;i<4;i++){w[i]=0;}{crossed=0;}{done=0;}{floor=0;}}
 bool StateFields(HG5StateCodec &codec){{if(!codec.I32(e))return false;}{if(!codec.I32(s))return false;}{if(!codec.I32(px))return false;}{if(!codec.I64(t0))return false;}{if(!codec.F32(due))return false;}{if(!codec.F32(v))return false;}{if(!codec.I32(peak))return false;}{if(!codec.I32(low))return false;}{if(!codec.I32(pk))return false;}{if(!codec.I32(lk))return false;}{if(!codec.I32(prev))return false;}{if(!codec.I32(prevsign))return false;}{if(!codec.I32(turns))return false;}{if(!codec.I32(anchor))return false;}{if(!codec.I64(last))return false;}for(int i=0;i<3;i++){if(!codec.F64(pos[i]))return false;}for(int i=0;i<3;i++){if(!codec.F64(neg[i]))return false;}for(int i=0;i<3;i++){if(!codec.F64(up[i]))return false;}for(int i=0;i<3;i++){if(!codec.F64(dn[i]))return false;}{if(!codec.F64(travel))return false;}{if(!codec.F64(noise))return false;}for(int i=0;i<3;i++){if(!codec.F64(vel[i]))return false;}for(int i=0;i<3;i++){if(!codec.F64(intensity[i]))return false;}{if(!codec.F64(jump))return false;}{if(!codec.F64(rv))return false;}{if(!codec.F64(bv))return false;}{if(!codec.F64(oldabs))return false;}{if(!codec.F64(spreadema))return false;}{if(!codec.F64(under))return false;}{if(!codec.F64(over))return false;}{if(!codec.F64(run))return false;}for(int i=0;i<4;i++){if(!codec.I32(w[i]))return false;}{if(!codec.Flag(crossed))return false;}{if(!codec.Flag(done))return false;}{if(!codec.F32(floor))return false;}return true;}
};
#endif
